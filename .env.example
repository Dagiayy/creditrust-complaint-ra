# Copy this file to `.env` and adjust as needed. All variables are optional —
# sensible defaults are defined in src/creditrust/config.py.
# Every value here is read by pydantic-settings with the CREDITRUST_ prefix.

# --- Filtering ---------------------------------------------------------------
# strict | expanded | all
CREDITRUST_FILTER_MODE=strict

# --- Embeddings / retrieval ----------------------------------------------------
CREDITRUST_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CREDITRUST_TOP_K=5

# --- LLM -----------------------------------------------------------------------
# local: run a HuggingFace model on this machine. mock: canned responses (tests/demo).
CREDITRUST_LLM_PROVIDER=local
CREDITRUST_LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# Required only for gated HuggingFace models.
# CREDITRUST_HF_TOKEN=

# --- API -------------------------------------------------------------------------
# If set, POST /api/v1/query requires a matching `X-API-Key` header.
# CREDITRUST_API_KEY=change-me

# --- Logging -----------------------------------------------------------------------
CREDITRUST_LOG_LEVEL=INFO
CREDITRUST_LOG_JSON=false
